   "start": 162.677,
   "end": 166.476,
   "runs": [
    [
     162.648,
     162.968
    ],
    [
     163.122,
     163.624
    ],
    [
     163.911,
     164.954
    ],
    [
     165.241,
     166.533
    ]
   ]
  },
  {
   "id": "b8.7",
   "beat": "b8",
   "act": 6,
   "text": "And right now is somebody's past.",
   "start": 166.857,
   "end": 168.685,
   "runs": [
    [
     166.857,
     168.685
    ]
   ]
  },
  {
   "id": "b8.8",
   "beat": "b8",
   "act": 6,
   "text": "So when your phone rings tonight...",
   "start": 169.059,
   "end": 170.409,
   "runs": [
    [
     169.059,
     170.409
    ]
   ]
  },
  {
   "id": "b8.9",
   "beat": "b8",
   "act": 6,
   "text": "Pick up.",
   "start": 171.42,
   "end": 172.125,
   "runs": [
    [
     171.391,
     171.769
    ],
    [
     172.056,
     172.183
    ]
   ]
  }
 ],
 "captions": [
  {
   "line": "b1.1",
   "text": "TONIGHT, THE TIME MACHINE WORKS.",
   "start": 1.051,
   "end": 3.518,
   "emph": null
  },
  {
   "line": "b1.2",
   "text": "YOU GET ONE TRIP. AND YOU KNOW EXACTLY WHERE.",
   "start": 3.538,
   "end": 6.501,
   "emph": null
  },
  {
   "line": "b1.3",
   "text": "11 YEARS AGO. 9:14 AT NIGHT.",
   "start": 6.521,
   "end": 9.482,
   "emph": null
  },
  {
   "line": "b1.4",
   "text": "GRANDMA CALLED.",
   "start": 9.502,
   "end": 10.521,
   "emph": [
    "GRANDMA",
    "gold"
   ]
  },
  {
   "line": "b1.5",
   "text": "YOU WERE BUSY. YOU LET IT RING.",
   "start": 10.541,
   "end": 12.209,
   "emph": null
  },
  {
   "line": "b1.6",
   "text": "BY MORNING, SHE WAS GONE.",
   "start": 12.229,
   "end": 13.791,
   "emph": null
  },
  {
   "line": "b1.7",
   "text": "LATER, HER NEIGHBOR SAID SOMETHING STRANGE.",
   "start": 13.811,
   "end": 16.678,
   "emph": null
  },
  {
   "line": "b1.8",
   "text": "SOMEONE SAT WITH HER AT THE END.",
   "start": 16.698,
   "end": 18.563,
   "emph": null
  },
  {
   "line": "b1.8",
   "text": "A YOUNG PERSON, IN A COAT.",
   "start": 18.583,
   "end": 20.384,
   "emph": [
    "COAT.",
    "blue"
   ]
  },
  {
   "line": "b1.9",
   "text": "NOBODY KNEW WHO.",
   "start": 20.404,
   "end": 21.452,
   "emph": null
  },
  {
   "line": "b1.10",
   "text": "NOW YOU CAN FIX IT. THERE'S JUST ONE PROBLEM.",
   "start": 21.472,
   "end": 23.232,
   "emph": [
    "FIX",
    "teal"
   ]
  },
  {
   "line": "b1.11",
   "text": "TIME TRAVEL IS USELESS.",
   "start": 23.814,
   "end": 25.875,
   "emph": null
  },
  {
   "line": "b1.12",
   "text": "GIVE ME THREE MINUTES, AND I'LL PROVE IT.",
   "start": 25.895,
   "end": 29.39,
   "emph": null
  },
  {
   "line": "b2.1",
   "text": "ATTEMPT ONE. TRAIN CANCELLED.",
   "start": 29.658,
   "end": 31.413,
   "emph": [
    "CANCELLED.",
    "coral"
   ]
  },
  {
   "line": "b2.2",
   "text": "ATTEMPT TWO. YOUR ZIPPER JAMS.",
   "start": 31.433,
   "end": 33.027,
   "emph": [
    "JAMS.",
    "coral"
   ]
  },
  {
   "line": "b2.3",
   "text": "ATTEMPT THREE. THE TAXI DRIVER KNOWS A SHORTCUT.",
   "start": 33.047,
   "end": 35.594,
   "emph": [
    "SHORTCUT.",
    "coral"
   ]
  },
  {
   "line": "b2.4",
   "text": "HE DOES NOT KNOW A SHORTCUT.",
   "start": 35.614,
   "end": 37.291,
   "emph": [
    "SHORTCUT.",
    "coral"
   ]
  },
  {
   "line": "b2.5",
   "text": "SO YOU CALL YOUR YOUNGER SELF.",
   "start": 37.311,
   "end": 38.841,
   "emph": null
  },
  {
   "line": "b2.5",
   "text": "GO TO HER. RIGHT NOW.",
   "start": 38.861,
   "end": 40.139,
   "emph": [
    "HER.",
    "gold"
   ]
  },
  {
   "line": "b2.6",
   "text": "HE THINKS IT'S A PRANK. HONESTLY? SO WOULD YOU.",
   "start": 40.159,
   "end": 42.638,
   "emph": [
    "PRANK.",
    "coral"
   ]
  },
  {
   "line": "b2.7",
   "text": "214 TRIES.",
   "start": 42.658,
   "end": 44.946,
   "emph": [
    "214",
    "coral"
   ]
  },
  {
   "line": "b2.8",
   "text": "IT'S NOT BAD LUCK.",
   "start": 44.966,
   "end": 46.14,
   "emph": null
  },
  {
   "line": "b2.9",
   "text": "IT'S A RULE.",
   "start": 46.16,
   "end": 47.472,
   "emph": [
    "RULE.",
    "coral"
   ]
  },
  {
   "line": "b3.1",
   "text": "IN THE 1980S, PHYSICIST IGOR NOVIKOV HAD AN IDEA.",
   "start": 47.724,
   "end": 51.305,
   "emph": null
  },
  {
   "line": "b3.2",
   "text": "THINK OF HISTORY LIKE A",
   "start": 51.325,
   "end": 52.474,
   "emph": null
  },
  {
   "line": "b3.2",
   "text": "MOVIE THAT'S ALREADY BEEN FILMED.",
   "start": 52.494,
   "end": 54.482,
   "emph": null
  },
  {
   "line": "b3.3",
   "text": "YOU CAN BE IN IT.",
   "start": 54.502,
   "end": 55.53,
   "emph": null
  },
  {
   "line": "b3.3",
   "text": "YOU JUST CAN'T EDIT IT.",
   "start": 55.55,
   "end": 56.77,
   "emph": [
    "EDIT",
    "coral"
   ]
  },
  {
   "line": "b3.4",
   "text": "SCIENTISTS TESTED IT WITH POOL BALLS. ON PAPER.",
   "start": 56.79,
   "end": 59.841,
   "emph": [
    "PAPER.",
    "violet"
   ]
  },
  {
   "line": "b3.5",
   "text": "A BALL ROLLS INTO A TIME TUNNEL,",
   "start": 59.861,
   "end": 61.975,
   "emph": null
  },
  {
   "line": "b3.5",
   "text": "AND COMES OUT EARLIER.",
   "start": 61.995,
   "end": 63.413,
   "emph": null
  },
  {
   "line": "b3.6",
   "text": "IT TRIES TO KNOCK ITS YOUNGER SELF AWAY.",
   "start": 63.433,
   "end": 65.758,
   "emph": null
  },
  {
   "line": "b3.7",
   "text": "THE MATH SAYS NO.",
   "start": 65.778,
   "end": 67.846,
   "emph": [
    "NO.",
    "coral"
   ]
  },
  {
   "line": "b4.1",
   "text": "THE ONLY SHOT THAT WORKS,",
   "start": 67.866,
   "end": 69.516,
   "emph": null
  },
  {
   "line": "b4.1",
   "text": "KNOCKS THE YOUNG BALL IN.",
   "start": 69.536,
   "end": 71.274,
   "emph": null
  },
  {
   "line": "b4.2",
   "text": "IT CAN'T STOP ITSELF.",
   "start": 71.294,
   "end": 72.648,
   "emph": null
  },
  {
   "line": "b4.2",
   "text": "IT CAN ONLY BE THE REASON.",
   "start": 72.668,
   "end": 74.593,
   "emph": [
    "REASON.",
    "gold"
   ]
  },
  {
   "line": "b4.3",
   "text": "YOU STILL CHOOSE.",
   "start": 74.613,
   "end": 75.791,
   "emph": [
    "CHOOSE.",
    "teal"
   ]
  },
  {
   "line": "b4.4",
   "text": "INSIDE A STORY THAT ALREADY",
   "start": 75.811,
   "end": 77.073,
   "emph": null
  },
  {
   "line": "b4.4",
   "text": "HAS YOUR NAME IN IT.",
   "start": 77.093,
   "end": 78.415,
   "emph": [
    "NAME",
    "gold"
   ]
  },
  {
   "line": "b4.5",
   "text": "IS ANY OF THIS REAL? KIND OF.",
   "start": 78.435,
   "end": 80.328,
   "emph": null
  },
  {
   "line": "b4.6",
   "text": "ONE COSMONAUT CAME BACK FROM SPACE,",
   "start": 80.348,
   "end": 83.223,
   "emph": null
  },
  {
   "line": "b4.6",
   "text": "1/50 OF A SECOND IN THE FUTURE.",
   "start": 83.243,
   "end": 86.424,
   "emph": [
    "FUTURE.",
    "teal"
   ]
  },
  {
   "line": "b5.1",
   "text": "FORWARD IS EASY. BACKWARD ONLY WORKS ON PAPER.",
   "start": 86.444,
   "end": 90.65,
   "emph": [
    "PAPER.",
    "violet"
   ]
  },
  {
   "line": "b5.2",
   "text": "NOBODY HAS EVER BUILT A TIME MACHINE.",
   "start": 90.67,
   "end": 93.465,
   "emph": null
  },
  {
   "line": "b5.3",
   "text": "STEPHEN HAWKING ONCE THREW A PARTY FOR TIME TRAVELERS.",
   "start": 93.485,
   "end": 96.528,
   "emph": null
  },
  {
   "line": "b5.4",
   "text": "HE SENT THE INVITES AFTER THE PARTY.",
   "start": 96.548,
   "end": 99.145,
   "emph": null
  },
  {
   "line": "b5.5",
   "text": "NOBODY CAME.",
   "start": 99.403,
   "end": 100.332,
   "emph": [
    "CAME.",
    "coral"
   ]
  },
  {
   "line": "b5.6",
   "text": "OR SOMEBODY DID,",
   "start": 100.352,
   "end": 100.978,
   "emph": null
  },
  {
   "line": "b5.6",
   "text": "AND LEFT EVERYTHING EXACTLY AS THEY FOUND IT.",
   "start": 100.998,
   "end": 104.506,
   "emph": null
  },
  {
   "line": "b5.7",
   "text": "REMEMBER THAT.",
   "start": 104.526,
   "end": 105.92,
   "emph": null
  },
  {
   "line": "b6a.1",
   "text": "THERE'S ONE WAY OUT.",
   "start": 106.148,
   "end": 107.344,
   "emph": null
  },
  {
   "line": "b6a.2",
   "text": "PHYSICIST DAVID DEUTSCH SAID THE UNIVERSE MIGHT SPLIT.",
   "start": 107.364,
   "end": 111.245,
   "emph": [
    "SPLIT.",
    "violet"
   ]
  },
  {
   "line": "b6a.3",
   "text": "CHANGE THE PAST, AND YOU MAKE A NEW TIMELINE.",
   "start": 111.265,
   "end": 114.032,
   "emph": null
  },
  {
   "line": "b6a.4",
   "text": "YOU COULD SAVE A GRANDMA. JUST NOT YOURS.",
   "start": 114.052,
   "end": 117.394,
   "emph": null
  },
  {
   "line": "b6b.1",
   "text": "YOU DON'T WANT A GRANDMA.",
   "start": 117.429,
   "end": 119.304,
   "emph": null
  },
  {
   "line": "b6b.2",
   "text": "YOU WANT HER.",
   "start": 119.382,
   "end": 120.714,
   "emph": [
    "HER.",
    "gold"
   ]
  },
  {
   "line": "b6b.3",
   "text": "SO YOU STOP TRYING TO FIX IT.",
   "start": 120.734,
   "end": 122.945,
   "emph": [
    "FIX",
    "teal"
   ]
  },
  {
   "line": "b6b.4",
   "text": "ATTEMPT 215. YOU JUST GO.",
   "start": 122.965,
   "end": 127.331,
   "emph": [
    "GO.",
    "teal"
   ]
  },
  {
   "line": "b7.1",
   "text": "HER DOOR ISN'T LOCKED. IT NEVER WAS.",
   "start": 127.605,
   "end": 129.926,
   "emph": null
  },
  {
   "line": "b7.2",
   "text": "SAME KITCHEN. SAME TEA. SAME SLOW CLOCK.",
   "start": 129.946,
   "end": 133.307,
   "emph": null
  },
  {
   "line": "b7.3",
   "text": "9:14. ACROSS TOWN, YOUR PHONE STARTS RINGING.",
   "start": 133.327,
   "end": 137.41,
   "emph": null
  },
  {
   "line": "b7.4",
   "text": "YOUNGER YOU LETS IT RING.",
   "start": 137.43,
   "end": 139.105,
   "emph": null
  },
  {
   "line": "b7.5",
   "text": "SHE SEES YOU IN THE DOORWAY.",
   "start": 139.125,
   "end": 140.758,
   "emph": null
  },
  {
   "line": "b7.6",
   "text": "SHE DOESN'T ASK WHO YOU ARE.",
   "start": 140.778,
   "end": 142.207,
   "emph": null
  },
  {
   "line": "b7.6",
   "text": "SHE JUST SLIDES A CUP OVER.",
   "start": 142.227,
   "end": 144.384,
   "emph": null
  },
  {
   "line": "b7.7",
   "text": "AND YOU SIT.",
   "start": 144.551,
   "end": 145.978,
   "emph": [
    "SIT.",
    "gold"
   ]
  },
  {
   "line": "b8.1",
   "text": "YOU CAN'T STOP WHAT'S COMING.",
   "start": 146.972,
   "end": 148.751,
   "emph": null
  },
  {
   "line": "b8.2",
   "text": "BUT TONIGHT, SHE ISN'T ALONE.",
   "start": 148.771,
   "end": 151.058,
   "emph": [
    "ALONE.",
    "gold"
   ]
  },
  {
   "line": "b8.3",
   "text": "ACROSS THE STREET, THE NEIGHBOR SEES",
   "start": 151.078,
   "end": 153.222,
   "emph": null
  },
  {
   "line": "b8.3",
   "text": "A YOUNG PERSON IN A BLUE COAT.",
   "start": 153.242,
   "end": 155.335,
   "emph": [
    "COAT.",
    "blue"
   ]
  },
  {
   "line": "b8.4",
   "text": "YOU DIDN'T CHANGE A THING.",
   "start": 155.355,
   "end": 157.081,
   "emph": null
  },
  {
   "line": "b8.4",
   "text": "YOU LEFT EVERYTHING EXACTLY AS YOU FOUND IT.",
   "start": 157.101,
   "end": 159.777,
   "emph": null
  },
  {
   "line": "b8.5",
   "text": "YOU WERE THE PART NOBODY COULD EXPLAIN.",
   "start": 159.797,
   "end": 162.289,
   "emph": [
    "EXPLAIN.",
    "gold"
   ]
  },
  {
   "line": "b8.6",
   "text": "SO YES. TIME TRAVEL IS USELESS...",
   "start": 162.647,
   "end": 165.191,
   "emph": [
    "USELESS...",
    "gold"
   ]
  },
  {
   "line": "b8.6",
   "text": "UNLESS YOU JUST WANT TO BE THERE.",
   "start": 165.211,
   "end": 166.807,
   "emph": [
    "THERE.",
    "teal"
   ]
  },
  {
   "line": "b8.7",
   "text": "AND RIGHT NOW IS SOMEBODY'S PAST.",
   "start": 166.827,
   "end": 169.009,
   "emph": [
    "PAST.",
    "violet"
   ]
  },
  {
   "line": "b8.8",
   "text": "SO WHEN YOUR PHONE RINGS TONIGHT...",
   "start": 169.029,
   "end": 170.909,
   "emph": null
  },
  {
   "line": "b8.9",
   "text": "PICK UP.",
   "start": 171.39,
   "end": 172.625,
   "emph": [
    "UP.",
    "teal"
   ]
  }
 ],
